{
  "uid": "eva3-seguridad",
  "title": "EVA3 - Monitoreo de seguridad",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat", "title": "Login fallidos (401) + bloqueos (429) - últimos 5 min",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(flask_http_request_total{status=~\"401|429\"}[5m])) or vector(0)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 } ] } } }
    },
    {
      "type": "stat", "title": "Peticiones rechazadas por CSRF / inválidas (400) - últimos 5 min",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(flask_http_request_total{status=\"400\"}[5m])) or vector(0)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] } } }
    },
    {
      "type": "stat", "title": "Errores del servidor (5xx) - últimos 5 min",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(flask_http_request_total{status=~\"5..\"}[5m])) or vector(0)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "type": "timeseries", "title": "Tasa de peticiones HTTP por código de estado (req/s)",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(flask_http_request_total[1m]))", "legendFormat": "HTTP {{status}}" } ]
    },
    {
      "type": "timeseries", "title": "Uso de CPU del contenedor (núcleos)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"eva3-app\"}[1m])", "legendFormat": "CPU" } ]
    },
    {
      "type": "timeseries", "title": "Memoria RAM del contenedor",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "process_resident_memory_bytes{job=\"eva3-app\"}", "legendFormat": "RAM" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
